# TuiSense web demo configuration (docker compose reads this file as .env).
# Every TUISENSE_WEB_* value is optional; the defaults are shown.

# Public host name. Caddy obtains its HTTPS certificate automatically, and
# the backend only accepts terminal connections from https://$DEMO_DOMAIN.
DEMO_DOMAIN=demo.example.com

# Whole-service ceilings for the backend container.
BACKEND_MEMORY=3g
BACKEND_CPUS=4

# --- Sessions -------------------------------------------------------------
# Concurrent sessions on this server, and per client address.
TUISENSE_WEB_MAX_SESSIONS=24
TUISENSE_WEB_MAX_SESSIONS_PER_IP=3
# New sessions per client address per minute.
TUISENSE_WEB_STARTS_PER_MINUTE=6
# A session ends after this long without keyboard or mouse input...
TUISENSE_WEB_IDLE_TIMEOUT=10m
# ...and after this long in any case.
TUISENSE_WEB_MAX_DURATION=30m
# How long a session survives a dropped connection (page reload, network).
TUISENSE_WEB_RECONNECT_GRACE=45s
# Keyboard, mouse and paste bytes per session per second (burst: twice that).
TUISENSE_WEB_INPUT_BYTES_PER_SEC=32768

# --- Per-session process limits -------------------------------------------
# Address space (RLIMIT_AS). The Go runtime needs at least 768 MiB of
# address space; actual memory use is far lower.
TUISENSE_WEB_MEMORY_LIMIT_MB=1024
# The garbage collector's memory target (GOMEMLIMIT).
TUISENSE_WEB_SOFT_MEMORY_MB=160
# Total CPU seconds (RLIMIT_CPU), parallelism (GOMAXPROCS) and niceness.
TUISENSE_WEB_CPU_SECONDS=600
TUISENSE_WEB_GOMAXPROCS=1
TUISENSE_WEB_NICE=10
TUISENSE_WEB_MAX_OPEN_FILES=64
TUISENSE_WEB_MAX_FILE_SIZE_MB=8
TUISENSE_WEB_FPS=30

# --- Confinement ----------------------------------------------------------
# strict:   require Linux namespaces and Landlock (systemd/VPS installs)
# landlock: require Landlock, use namespaces if allowed (Docker's default
#           seccomp profile forbids namespaces; Landlock still confines
#           files, TCP and signals)
# auto:     apply what the kernel allows and log what is missing
# minimal:  rlimits and no_new_privs only (local development)
TUISENSE_WEB_SANDBOX=landlock

# Terminal sizes are kept between 40x12 and 320x120 characters.

# --- Links shown by /api/info ---------------------------------------------
TUISENSE_WEB_PUBLIC_GITHUB_URL=https://github.com/Phobby/TuiSense
TUISENSE_WEB_PUBLIC_DOWNLOAD_URL=https://github.com/Phobby/TuiSense/releases/latest

# Set by docker-compose.yml (do not change): TUISENSE_WEB_LISTEN,
# TUISENSE_WEB_TRUST_PROXY, TUISENSE_WEB_ALLOWED_ORIGINS.
# Other options: TUISENSE_WEB_STATIC_DIR (serve the built frontend from the
# backend itself), TUISENSE_WEB_SESSION_ROOT, TUISENSE_WEB_SHUTDOWN_WAIT.
