{
  "name": "tuisense-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "TuiSense website and browser terminal for the web demo (the UI inside the terminal is the real TuiSense)",
  "scripts": {
    "predev": "node scripts/copy-media.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-media.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/dejavu-mono": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
