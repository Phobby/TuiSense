# TuiSense — Sony DualSense & DualSense Edge Linux udev rules
# Installation:
#   sudo cp contrib/70-tuisense-dualsense.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# Sony DualSense Wireless Controller (CFI-ZCT1W) — USB & Bluetooth hidraw
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0CE6*", MODE="0660", TAG+="uaccess"

# Sony DualSense Edge Wireless Controller (CFI-ZCP1) — USB & Bluetooth hidraw
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0DF2*", MODE="0660", TAG+="uaccess"
